{
  "name": "codex-reset-observatory",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "observe:reddit": "node scripts/fetch-reddit-signals.mjs",
    "start": "next start",
    "lint": "eslint .",
    "monitor:x": "tsx scripts/monitor-tibo-x.ts",
