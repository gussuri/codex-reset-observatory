# Production/runtime values. Keep real values in the hosting provider or local .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
TIBO_WEBHOOK_SECRET=
CODEX_USAGE_MONITOR_SECRET=

# Optional Gemini classification and translation settings.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_CLASSIFICATION_MODE=
GEMINI_TRANSLATION_MODE=

# Optional server-side X API lookup for authoritative edit-chain metadata.
X_API_BEARER_TOKEN=

# Optional local Codex Usage Monitor settings.
CODEX_CLI_PATH=
CODEX_USAGE_WEBHOOK_URL=
CODEX_USAGE_POLL_INTERVAL_MS=

# GitHub Actions secret used by the scheduled workflow.
APP_URL=

# Optional Reddit fetch script settings.
REDDIT_USER_AGENT=
REDDIT_FETCH_DELAY_MS=
