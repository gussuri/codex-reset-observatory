{
  "manifest_version": 3,
  "name": "Codex Reset Observatory - Tibo Real-Time Monitor",
  "version": "1.0.0",
  "description": "Monitors Tibo (@thsottiaux) tweets on X in real-time and forwards signals to Codex Reset Observatory.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://codex.gussuriworks.com/*",
    "https://codex-reset-observatory.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/thsottiaux*",
        "https://x.com/notifications*",
        "https://twitter.com/thsottiaux*",
        "https://twitter.com/notifications*"
      ],
      "js": ["diagnostics.js", "runtime.js", "scan-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
